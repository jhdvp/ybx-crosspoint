--- /dev/null
+++ b/libs/network/SecureNet/include/DeadlineDns.h
@@ -0,0 +1,61 @@
+#pragma once
+
+// FreeInk SDK — deadline-bounded DNS for a connecting client.
+//
+// WHY: WiFiClient/NetworkClient resolve hostnames with lwip_getaddrinfo(), a
+// blocking call that neither a socket timeout nor an abort callback can
+// interrupt. A request that must finish before sleep therefore had no strict
+// wall-clock bound. This lookup drives lwIP's asynchronous resolver and waits
+// cooperatively, so both the caller's deadline and its abort callback apply.
+//
+// Dual-stack: an IPv4 query that comes back empty is retried as IPv6 under the
+// same deadline when the stack has a global IPv6, so AAAA-only hosts keep
+// resolving the way the previous blocking path resolved them.
+//
+// Lifetime: lwIP keeps retrying a DNS query for seconds after the waiter gives
+// up, so its completion callback may arrive late. Results are published into a
+// fixed set of static slots that the callback alone releases; no callback
+// points at caller state, no task is created, and retrying a timed-out lookup
+// cannot grow memory.
+
+#include <Arduino.h>
+
+#include <cstdint>
+#include <functional>
+
+namespace freeink {
+
+// millis() deadline arithmetic; correct across the 32-bit millis() wraparound
+// as long as the budget is below 2^31 ms.
+inline uint32_t deadlineAfter(uint32_t now, uint32_t budgetMs) { return now + budgetMs; }
+inline uint32_t remainingUntil(uint32_t now, uint32_t deadlineMs) {
+  const int32_t left = static_cast<int32_t>(deadlineMs - now);
+  return left > 0 ? static_cast<uint32_t>(left) : 0;
+}
+
+class DeadlineDns {
+ public:
+  enum class Status : uint8_t {
+    Ok,
+    Failed,       // no address (unknown host, resolver error, no DNS server)
+    Timeout,      // the caller's deadline expired while a lookup was outstanding
+    Busy,         // the deadline expired while every slot held an abandoned lookup
+    Aborted,      // shouldAbort() asked to stop
+    Unavailable,  // no resolver backend in this build (host tests)
+  };
+  using AbortFn = std::function<bool()>;
+
+  // Resolves host to an IPv4 or, when only an IPv6 exists and the interface
+  // has one, an IPv6 IPAddress, before deadlineMs, polling shouldAbort once
+  // per millisecond. A literal address needs no DNS. While every slot is
+  // occupied the lookup waits (up to the deadline) for one to free, so a
+  // cached host still resolves during a burst of abandoned lookups. On
+  // Unavailable a caller may fall back to a blocking hostname connect.
+  static Status resolve(const char* host, uint32_t deadlineMs, IPAddress& address, const AbortFn& shouldAbort);
+
+  // Strict dotted-quad parser. Leading-zero octets are rejected so this never
+  // disagrees with inet_aton's octal rules; such names go through DNS instead.
+  static bool parseIpv4(const char* host, uint32_t& ipv4);
+};
+
+}  // namespace freeink
