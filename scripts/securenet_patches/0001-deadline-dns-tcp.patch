diff --git a/libs/network/SecureNet/src/DeadlineDns.cpp b/libs/network/SecureNet/src/DeadlineDns.cpp
new file mode 100644
index 0000000..2bf7113
--- /dev/null
+++ b/libs/network/SecureNet/src/DeadlineDns.cpp
@@ -0,0 +1,157 @@
+#include "DeadlineDns.h"
+
+#include <Arduino.h>
+
+#if defined(ESP_PLATFORM)
+#include <lwip/dns.h>
+#include <lwip/ip_addr.h>
+#include <lwip/tcpip.h>
+#endif
+
+#include <atomic>
+#include <cstring>
+
+namespace freeink {
+
+bool DeadlineDns::parseIpv4(const char* host, uint32_t& ipv4) {
+  if (!host) return false;
+  uint8_t bytes[4];
+  const char* p = host;
+  for (int part = 0; part < 4; ++part) {
+    if (*p < '0' || *p > '9' || (p[0] == '0' && p[1] >= '0' && p[1] <= '9')) return false;
+    unsigned value = 0;
+    int digits = 0;
+    while (*p >= '0' && *p <= '9') {
+      value = value * 10 + static_cast<unsigned>(*p - '0');
+      if (++digits > 3) return false;
+      ++p;
+    }
+    if (value > 255) return false;
+    bytes[part] = static_cast<uint8_t>(value);
+    if (part < 3) {
+      if (*p != '.') return false;
+      ++p;
+    }
+  }
+  if (*p != '\0') return false;
+  // Match lwIP's in_addr.s_addr representation: the four bytes in wire order.
+  memcpy(&ipv4, bytes, sizeof(ipv4));
+  return true;
+}
+
+#if defined(ESP_PLATFORM)
+
+namespace {
+constexpr uint8_t SLOT_FREE = 0;
+constexpr uint8_t SLOT_ASKING = 1;     // owned by lwIP until its callback
+constexpr uint8_t SLOT_DONE = 2;
+constexpr uint8_t SLOT_FAILED = 3;
+constexpr uint8_t SLOT_ABANDONED = 4;  // waiter left; recycled by the callback
+
+// One slot per outstanding query. Four bounds both concurrency and static
+// memory at 4 * 8 bytes, independent of how often a lookup is retried.
+constexpr int SLOT_COUNT = 4;
+struct Slot {
+  std::atomic<uint8_t> state{SLOT_FREE};
+  std::atomic<uint32_t> ipv4{0};
+};
+Slot slots[SLOT_COUNT];
+
+int claimSlot() {
+  for (int i = 0; i < SLOT_COUNT; ++i) {
+    uint8_t expected = SLOT_FREE;
+    if (slots[i].state.compare_exchange_strong(expected, SLOT_ASKING)) return i;
+  }
+  return -1;
+}
+
+// Runs in the lwIP thread, under the core lock, possibly long after the
+// waiter returned: it must only touch the slot.
+void publish(int index, uint32_t ipv4) {
+  slots[index].ipv4.store(ipv4);
+  uint8_t expected = SLOT_ASKING;
+  if (!slots[index].state.compare_exchange_strong(expected, ipv4 ? SLOT_DONE : SLOT_FAILED)) {
+    slots[index].state.store(SLOT_FREE);  // abandoned: nobody will consume this
+  }
+}
+
+DeadlineDns::Status take(int index, bool ok, uint32_t& ipv4) {
+  if (ok) ipv4 = slots[index].ipv4.load();
+  slots[index].state.store(SLOT_FREE);
+  return ok ? DeadlineDns::Status::Ok : DeadlineDns::Status::Failed;
+}
+
+// Leaves the slot to lwIP unless its answer already landed; a late callback
+// is then the only thing that recycles an abandoned slot.
+void abandon(int index) {
+  uint8_t expected = SLOT_ASKING;
+  if (!slots[index].state.compare_exchange_strong(expected, SLOT_ABANDONED) &&
+      (expected == SLOT_DONE || expected == SLOT_FAILED)) {
+    slots[index].state.store(SLOT_FREE);
+  }
+}
+
+DeadlineDns::Status waitFor(int index, uint32_t deadlineMs, uint32_t& ipv4,
+                            const DeadlineDns::AbortFn& shouldAbort) {
+  for (;;) {
+    const uint8_t state = slots[index].state.load();
+    if (state == SLOT_DONE) return take(index, true, ipv4);
+    if (state == SLOT_FAILED) return take(index, false, ipv4);
+    if (shouldAbort && shouldAbort()) {
+      abandon(index);
+      return DeadlineDns::Status::Aborted;
+    }
+    if (remainingUntil(millis(), deadlineMs) == 0) {
+      abandon(index);
+      return DeadlineDns::Status::Timeout;
+    }
+    delay(1);
+  }
+}
+
+void found(const char* /*host*/, const ip_addr_t* addr, void* arg) {
+  uint32_t ipv4 = 0;
+  if (addr && IP_IS_V4(addr)) ipv4 = ip4_addr_get_u32(ip_2_ip4(addr));
+  publish(static_cast<int>(reinterpret_cast<intptr_t>(arg)), ipv4);
+}
+
+bool start(const char* host, int index) {
+  ip_addr_t addr;
+  err_t err;
+  // Raw lwIP API: app tasks must hold the core lock; the callback runs under
+  // it, which is why publish() uses atomics instead of taking the lock.
+  LOCK_TCPIP_CORE();
+  err = dns_gethostbyname_addrtype(host, &addr, found, reinterpret_cast<void*>(static_cast<intptr_t>(index)),
+                                   LWIP_DNS_ADDRTYPE_IPV4);
+  UNLOCK_TCPIP_CORE();
+  if (err == ERR_OK) {  // already cached: complete the slot ourselves
+    publish(index, IP_IS_V4(&addr) ? ip4_addr_get_u32(ip_2_ip4(&addr)) : 0);
+    return true;
+  }
+  if (err == ERR_INPROGRESS) return true;
+  slots[index].state.store(SLOT_FREE);
+  return false;
+}
+}  // namespace
+
+DeadlineDns::Status DeadlineDns::resolve(const char* host, uint32_t deadlineMs, uint32_t& ipv4,
+                                         const AbortFn& shouldAbort) {
+  if (!host || !host[0]) return Status::Failed;
+  if (parseIpv4(host, ipv4)) return Status::Ok;
+  if (remainingUntil(millis(), deadlineMs) == 0) return Status::Timeout;
+  if (shouldAbort && shouldAbort()) return Status::Aborted;
+  const int index = claimSlot();
+  if (index < 0) return Status::Timeout;
+  if (!start(host, index)) return Status::Failed;
+  return waitFor(index, deadlineMs, ipv4, shouldAbort);
+}
+
+#else  // !ESP_PLATFORM
+
+DeadlineDns::Status DeadlineDns::resolve(const char*, uint32_t, uint32_t&, const AbortFn&) {
+  return Status::Unavailable;
+}
+
+#endif
+
+}  // namespace freeink
