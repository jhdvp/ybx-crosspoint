diff --git a/libs/network/SecureNet/src/DeadlineDns.cpp b/libs/network/SecureNet/src/DeadlineDns.cpp
new file mode 100644
--- /dev/null
+++ b/libs/network/SecureNet/src/DeadlineDns.cpp
@@ -0,0 +1,217 @@
+#include "DeadlineDns.h"
+
+#include <Arduino.h>
+
+#if defined(ESP_PLATFORM)
+#include <lwip/dns.h>
+#include <lwip/ip6_addr.h>
+#include <lwip/ip_addr.h>
+#include <lwip/netif.h>
+#include <lwip/tcpip.h>
+#endif
+
+#include <atomic>
+#include <cstring>
+
+namespace freeink {
+
+bool DeadlineDns::parseIpv4(const char* host, uint32_t& ipv4) {
+  if (!host) return false;
+  uint8_t bytes[4];
+  const char* p = host;
+  for (int part = 0; part < 4; ++part) {
+    if (*p < '0' || *p > '9' || (p[0] == '0' && p[1] >= '0' && p[1] <= '9')) return false;
+    unsigned value = 0;
+    int digits = 0;
+    while (*p >= '0' && *p <= '9') {
+      value = value * 10 + static_cast<unsigned>(*p - '0');
+      if (++digits > 3) return false;
+      ++p;
+    }
+    if (value > 255) return false;
+    bytes[part] = static_cast<uint8_t>(value);
+    if (part < 3) {
+      if (*p != '.') return false;
+      ++p;
+    }
+  }
+  if (*p != '\0') return false;
+  // Match lwIP's in_addr.s_addr representation: the four bytes in wire order.
+  memcpy(&ipv4, bytes, sizeof(ipv4));
+  return true;
+}
+
+#if defined(ESP_PLATFORM)
+
+namespace {
+constexpr uint8_t SLOT_FREE = 0;
+constexpr uint8_t SLOT_ASKING = 1;  // owned by lwIP until its callback
+constexpr uint8_t SLOT_DONE = 2;
+constexpr uint8_t SLOT_FAILED = 3;
+constexpr uint8_t SLOT_ABANDONED = 4;  // waiter left; recycled by the callback
+
+// One slot per outstanding query. Four bounds both concurrency and static
+// memory at 4 * sizeof(slot), independent of how often a lookup is retried.
+constexpr int SLOT_COUNT = 4;
+struct Slot {
+  std::atomic<uint8_t> state{SLOT_FREE};
+  // Guarded by the state transitions: the callback writes it before moving
+  // the slot to DONE, the waiter reads it only after seeing DONE.
+  ip_addr_t addr;
+};
+Slot slots[SLOT_COUNT];
+
+int claimSlot() {
+  for (int i = 0; i < SLOT_COUNT; ++i) {
+    uint8_t expected = SLOT_FREE;
+    if (slots[i].state.compare_exchange_strong(expected, SLOT_ASKING)) return i;
+  }
+  return -1;
+}
+
+// Runs in the lwIP thread, under the core lock, possibly long after the
+// waiter left: it must only touch the slot.
+void publish(int index, const ip_addr_t* addr) {
+  const bool ok = addr != nullptr;
+  if (ok) slots[index].addr = *addr;
+  uint8_t expected = SLOT_ASKING;
+  if (!slots[index].state.compare_exchange_strong(expected, ok ? SLOT_DONE : SLOT_FAILED)) {
+    slots[index].state.store(SLOT_FREE);  // abandoned: nobody will consume this
+  }
+}
+
+DeadlineDns::Status take(int index, bool ok, IPAddress& address) {
+  if (ok) address = IPAddress(&slots[index].addr);
+  slots[index].state.store(SLOT_FREE);
+  return ok ? DeadlineDns::Status::Ok : DeadlineDns::Status::Failed;
+}
+
+// Leaves the slot to lwIP unless its answer already landed; a late callback
+// is then the only thing that recycles an abandoned slot.
+void abandon(int index) {
+  uint8_t expected = SLOT_ASKING;
+  if (!slots[index].state.compare_exchange_strong(expected, SLOT_ABANDONED) &&
+      (expected == SLOT_DONE || expected == SLOT_FAILED)) {
+    slots[index].state.store(SLOT_FREE);
+  }
+}
+
+DeadlineDns::Status waitFor(int index, uint32_t deadlineMs, IPAddress& address,
+                            const DeadlineDns::AbortFn& shouldAbort) {
+  for (;;) {
+    const uint8_t state = slots[index].state.load();
+    if (state == SLOT_DONE) return take(index, true, address);
+    if (state == SLOT_FAILED) return take(index, false, address);
+    if (shouldAbort && shouldAbort()) {
+      abandon(index);
+      return DeadlineDns::Status::Aborted;
+    }
+    if (remainingUntil(millis(), deadlineMs) == 0) {
+      abandon(index);
+      return DeadlineDns::Status::Timeout;
+    }
+    delay(1);
+  }
+}
+
+void found(const char* /*host*/, const ip_addr_t* addr, void* arg) {
+  publish(static_cast<int>(reinterpret_cast<intptr_t>(arg)), addr);
+}
+
+bool start(const char* host, int index, uint8_t addrtype) {
+  ip_addr_t addr;
+  err_t err;
+  // Raw lwIP API: app tasks must hold the core lock; the callback runs under
+  // it, which is why publish() uses atomics instead of taking the lock.
+  LOCK_TCPIP_CORE();
+  err = dns_gethostbyname_addrtype(host, &addr, found, reinterpret_cast<void*>(static_cast<intptr_t>(index)), addrtype);
+  UNLOCK_TCPIP_CORE();
+  if (err == ERR_OK) {  // already cached: complete the slot ourselves
+    publish(index, &addr);
+    return true;
+  }
+  if (err == ERR_INPROGRESS) return true;
+  slots[index].state.store(SLOT_FREE);
+  return false;
+}
+
+// One address family. An empty slot is claimed and released as before; when
+// every slot holds an abandoned query the lookup waits for one to free, so a
+// cached host still resolves and an abandoned slot recovers within the
+// deadline instead of failing every later lookup instantly.
+DeadlineDns::Status lookup(const char* host, uint32_t deadlineMs, uint8_t addrtype, IPAddress& address,
+                           const DeadlineDns::AbortFn& shouldAbort) {
+  if (remainingUntil(millis(), deadlineMs) == 0) return DeadlineDns::Status::Timeout;
+  for (;;) {
+    const int index = claimSlot();
+    if (index >= 0) {
+      if (!start(host, index, addrtype)) return DeadlineDns::Status::Failed;
+      return waitFor(index, deadlineMs, address, shouldAbort);
+    }
+    if (shouldAbort && shouldAbort()) return DeadlineDns::Status::Aborted;
+    if (remainingUntil(millis(), deadlineMs) == 0) return DeadlineDns::Status::Busy;
+    delay(1);
+  }
+}
+
+#if LWIP_IPV6
+// True when an up interface holds a valid global-scope IPv6, mirroring the
+// check NetworkManager::hostByName() makes before asking for AAAA: without one
+// the device could not send on the answer, so the query would be wasted.
+bool hasGlobalIPv6() {
+  bool global = false;
+  LOCK_TCPIP_CORE();
+  for (struct netif* iface = netif_list; iface != nullptr && !global; iface = iface->next) {
+    if (!netif_is_up(iface)) continue;
+    for (int i = 0; i < LWIP_IPV6_NUM_ADDRESSES; ++i) {
+      if (ip6_addr_isvalid(netif_ip6_addr_state(iface, i)) && ip6_addr_isglobal(netif_ip6_addr(iface, i))) {
+        global = true;
+        break;
+      }
+    }
+  }
+  UNLOCK_TCPIP_CORE();
+  return global;
+}
+#endif
+}  // namespace
+
+DeadlineDns::Status DeadlineDns::resolve(const char* host, uint32_t deadlineMs, IPAddress& address,
+                                         const AbortFn& shouldAbort) {
+  if (!host || !host[0]) return Status::Failed;
+  uint32_t ipv4 = 0;
+  if (parseIpv4(host, ipv4)) {
+    address = IPAddress(ipv4);
+    return Status::Ok;
+  }
+  if (strchr(host, ':') != nullptr) {  // literal IPv6 (no zone): needs no DNS
+    IPAddress literal;
+    if (literal.fromString(host)) {
+      address = literal;
+      return Status::Ok;
+    }
+  }
+  if (remainingUntil(millis(), deadlineMs) == 0) return Status::Timeout;
+  if (shouldAbort && shouldAbort()) return Status::Aborted;
+  const Status first = lookup(host, deadlineMs, LWIP_DNS_ADDRTYPE_IPV4, address, shouldAbort);
+#if LWIP_IPV6
+  // Dual-stack: a host with only an AAAA record used to resolve through the
+  // blocking path. Retry that query as IPv6 under the same deadline; a second
+  // empty answer keeps the overall result Failed.
+  if (first == Status::Failed && remainingUntil(millis(), deadlineMs) > 0 && hasGlobalIPv6()) {
+    const Status second = lookup(host, deadlineMs, LWIP_DNS_ADDRTYPE_IPV6, address, shouldAbort);
+    if (second != Status::Failed) return second;
+  }
+#endif
+  return first;
+}
+
+#else  // !ESP_PLATFORM
+
+DeadlineDns::Status DeadlineDns::resolve(const char*, uint32_t, IPAddress&, const AbortFn&) {
+  return Status::Unavailable;
+}
+
+#endif
+
+}  // namespace freeink
