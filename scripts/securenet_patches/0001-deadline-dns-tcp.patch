new file mode 100644
index 0000000..cedc248
--- /dev/null
+++ b/libs/network/SecureNet/test/host/stubs/lwip/dns.h
@@ -0,0 +1,76 @@
+#pragma once
+// Host stub: a scripted asynchronous resolver. dns_gethostbyname_addrtype()
+// records the completion callback and the test completes or fails it
+// explicitly, which also models an answer arriving after the waiter left.
+#include "lwip/ip_addr.h"
+
+#include <cstdint>
+
+typedef int err_t;
+#define ERR_OK 0
+#define ERR_MEM -1
+#define ERR_INPROGRESS -5
+
+#define LWIP_DNS_ADDRTYPE_IPV4 0
+
+typedef void (*dns_found_callback)(const char* name, const ip_addr_t* ipaddr, void* callback_arg);
+
+struct FakeDnsPending {
+  const char* host = nullptr;
+  dns_found_callback found = nullptr;
+  void* arg = nullptr;
+};
+
+struct FakeDns {
+  static constexpr int MAX_PENDING = 8;
+  inline static FakeDnsPending pending[MAX_PENDING];
+  inline static int pendingCount = 0;
+  inline static int started = 0;
+  inline static err_t immediate = ERR_INPROGRESS;
+  inline static uint32_t immediateIpv4 = 0;
+  inline static bool completeOnStart = false;
+
+  static void reset() {
+    pendingCount = 0;
+    started = 0;
+    immediate = ERR_INPROGRESS;
+    immediateIpv4 = 0;
+    completeOnStart = false;
+    for (auto& entry : pending) entry = FakeDnsPending{};
+  }
+};
+
+inline void fakeDnsComplete(int index, uint32_t ipv4) {
+  const FakeDnsPending entry = FakeDns::pending[index];
+  FakeDns::pending[index] = FakeDnsPending{};
+  if (!entry.found) return;
+  ip_addr_t addr{};
+  addr.type = IPADDR_TYPE_V4;
+  addr.u_addr.ip4.addr = ipv4;
+  entry.found(entry.host, &addr, entry.arg);
+}
+
+inline void fakeDnsFail(int index) {
+  const FakeDnsPending entry = FakeDns::pending[index];
+  FakeDns::pending[index] = FakeDnsPending{};
+  if (entry.found) entry.found(entry.host, nullptr, entry.arg);
+}
+
+inline err_t dns_gethostbyname_addrtype(const char* hostname, ip_addr_t* addr, dns_found_callback found,
+                                       void* callback_arg, uint8_t dns_addrtype) {
+  (void)dns_addrtype;
+  FakeDns::started++;
+  if (FakeDns::immediate == ERR_OK) {
+    addr->type = IPADDR_TYPE_V4;
+    addr->u_addr.ip4.addr = FakeDns::immediateIpv4;
+    return ERR_OK;
+  }
+  if (FakeDns::immediate != ERR_INPROGRESS) return FakeDns::immediate;
+  if (FakeDns::pendingCount >= FakeDns::MAX_PENDING) return ERR_MEM;
+  FakeDns::pending[FakeDns::pendingCount++] = {hostname, found, callback_arg};
+  if (FakeDns::completeOnStart) {
+    FakeDns::completeOnStart = false;
+    fakeDnsFail(FakeDns::pendingCount - 1);
+  }
+  return ERR_INPROGRESS;
+}
