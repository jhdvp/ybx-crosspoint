+// by hostname through the fake WiFiClient (test_deadline_dns covers the
+// resolver itself), and one that does not must fail before any connect.
+DeadlineDns::Status DeadlineDns::resolve(const char*, uint32_t, IPAddress&, const AbortFn&) {
+  return dnsWorks ? DeadlineDns::Status::Unavailable : DeadlineDns::Status::Failed;
+}
