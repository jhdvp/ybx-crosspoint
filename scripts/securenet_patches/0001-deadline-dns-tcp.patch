diff --git a/libs/network/SecureNet/test/host/test_deadline_dns.cpp b/libs/network/SecureNet/test/host/test_deadline_dns.cpp
new file mode 100644
index 0000000..1d90b60
--- /dev/null
+++ b/libs/network/SecureNet/test/host/test_deadline_dns.cpp
@@ -0,0 +1,151 @@
+// Host test for DeadlineDns: deadline arithmetic, literal parsing, and the
+// slot protocol that outlives a cancelled lookup (late lwIP completion).
+#include <Arduino.h>
+#include <DeadlineDns.h>
+
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+
+#include "lwip/dns.h"
+
+using freeink::DeadlineDns;
+using freeink::deadlineAfter;
+using freeink::remainingUntil;
+
+namespace {
+uint32_t makeIp(uint8_t a, uint8_t b, uint8_t c, uint8_t d) {
+  const uint8_t bytes[4] = {a, b, c, d};
+  uint32_t ip = 0;
+  memcpy(&ip, bytes, sizeof(ip));
+  return ip;
+}
+
+void assertIp(uint32_t ip, uint8_t a, uint8_t b, uint8_t c, uint8_t d) {
+  uint8_t bytes[4];
+  memcpy(bytes, &ip, sizeof(bytes));
+  assert(bytes[0] == a && bytes[1] == b && bytes[2] == c && bytes[3] == d);
+}
+
+void resetClock() {
+  fakeNow() = 0;
+  FakeDns::reset();
+}
+
+uint32_t now32() { return static_cast<uint32_t>(fakeNow()); }
+}  // namespace
+
+int main() {
+  // Deadline arithmetic is correct across the millis() wraparound.
+  {
+    const uint32_t start = 0xFFFFFFF0u;
+    const uint32_t deadline = deadlineAfter(start, 0x20);
+    assert(remainingUntil(start, deadline) == 0x20);
+    assert(remainingUntil(0x00000000u, deadline) == 0x10);
+    assert(remainingUntil(0x00000020u, deadline) == 0);
+    assert(remainingUntil(0x00000021u, deadline) == 0);
+    assert(remainingUntil(start, start) == 0);
+    assert(remainingUntil(start + 1, start) == 0);
+  }
+
+  // Literal addresses resolve without touching the resolver, in in_addr order.
+  {
+    resetClock();
+    uint32_t ip = 0;
+    assert(DeadlineDns::parseIpv4("192.168.1.20", ip));
+    assertIp(ip, 192, 168, 1, 20);
+    assert(!DeadlineDns::parseIpv4("256.0.0.1", ip));
+    assert(!DeadlineDns::parseIpv4("1.2.3", ip));
+    assert(!DeadlineDns::parseIpv4("1.2.3.4.5", ip));
+    assert(!DeadlineDns::parseIpv4("a.b.c.d", ip));
+    assert(!DeadlineDns::parseIpv4(" 1.2.3.4", ip));
+    assert(!DeadlineDns::parseIpv4("01.2.3.4", ip));  // inet_aton would read octal
+    assert(!DeadlineDns::parseIpv4("", ip));
+    assert(!DeadlineDns::parseIpv4(nullptr, ip));
+    assert(DeadlineDns::resolve("10.0.0.7", deadlineAfter(0, 100), ip, nullptr) == DeadlineDns::Status::Ok);
+    assertIp(ip, 10, 0, 0, 7);
+    assert(FakeDns::started == 0);
+    assert(DeadlineDns::resolve(nullptr, deadlineAfter(0, 100), ip, nullptr) == DeadlineDns::Status::Failed);
+    assert(DeadlineDns::resolve("", deadlineAfter(0, 100), ip, nullptr) == DeadlineDns::Status::Failed);
+  }
+
+  // A resolver cache hit completes immediately.
+  {
+    resetClock();
+    FakeDns::immediate = ERR_OK;
+    FakeDns::immediateIpv4 = makeIp(10, 0, 0, 7);
+    uint32_t ip = 0;
+    assert(DeadlineDns::resolve("cached.test", deadlineAfter(0, 100), ip, nullptr) == DeadlineDns::Status::Ok);
+    assertIp(ip, 10, 0, 0, 7);
+    assert(FakeDns::started == 1);
+  }
+
+  // NXDOMAIN surfaces as a fast failure, not as a timeout.
+  {
+    resetClock();
+    FakeDns::completeOnStart = true;
+    uint32_t ip = 0;
+    assert(DeadlineDns::resolve("nx.test", deadlineAfter(0, 100), ip, nullptr) == DeadlineDns::Status::Failed);
+    assert(FakeDns::started == 1);
+    assert(fakeNow() == 0);
+  }
+
+  // A blackholed resolver stops at the caller's deadline, and its late answer
+  // is safe to deliver after the waiter has left.
+  {
+    resetClock();
+    uint32_t ip = 0;
+    assert(DeadlineDns::resolve("blackhole.test", deadlineAfter(0, 5), ip, nullptr) == DeadlineDns::Status::Timeout);
+    assert(fakeNow() == 5);
+    assert(FakeDns::pendingCount == 1);
+    fakeDnsComplete(0, makeIp(192, 0, 2, 1));
+  }
+
+  // Abort wins over a pending lookup without waiting for the deadline; the
+  // late answer is still delivered safely.
+  {
+    resetClock();
+    uint32_t ip = 0;
+    int checks = 0;
+    const DeadlineDns::AbortFn abort = [&checks] { return ++checks > 2; };
+    assert(DeadlineDns::resolve("abort.test", deadlineAfter(0, 1000), ip, abort) == DeadlineDns::Status::Aborted);
+    assert(fakeNow() < 1000);
+    assert(FakeDns::pendingCount == 1);
+    fakeDnsFail(0);
+  }
+
+  // Timeouts consume the fixed slot pool; only the late completions recycle
+  // them, and memory does not grow while they are outstanding.
+  {
+    resetClock();
+    uint32_t ip = 0;
+    for (int i = 0; i < 4; ++i) {
+      assert(DeadlineDns::resolve("hole.test", deadlineAfter(now32(), 2), ip, nullptr) == DeadlineDns::Status::Timeout);
+    }
+    assert(FakeDns::started == 4);
+    const unsigned long before = fakeNow();
+    assert(DeadlineDns::resolve("fifth.test", deadlineAfter(now32(), 1000), ip, nullptr) ==
+           DeadlineDns::Status::Timeout);
+    assert(FakeDns::started == 4);  // no slot, so no query was issued
+    assert(fakeNow() == before);    // and the failure is immediate
+    for (int i = 0; i < 4; ++i) fakeDnsComplete(i, makeIp(192, 0, 2, 3));
+    FakeDns::immediate = ERR_OK;
+    FakeDns::immediateIpv4 = makeIp(192, 0, 2, 4);
+    assert(DeadlineDns::resolve("after.test", deadlineAfter(now32(), 100), ip, nullptr) == DeadlineDns::Status::Ok);
+    assert(FakeDns::started == 5);
+  }
+
+  // A live timeout that crosses the millis() wraparound.
+  {
+    resetClock();
+    fakeNow() = 0xFFFFFFF0u;
+    uint32_t ip = 0;
+    const uint32_t deadline = deadlineAfter(now32(), 0x20);
+    assert(DeadlineDns::resolve("wrap.test", deadline, ip, nullptr) == DeadlineDns::Status::Timeout);
+    assert(now32() == 0x10);
+    fakeDnsComplete(0, makeIp(1, 2, 3, 4));
+  }
+
+  puts("test_deadline_dns: ok");
+  return 0;
+}
