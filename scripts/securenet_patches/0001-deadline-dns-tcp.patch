@@ -0,0 +1,36 @@
+#pragma once
+// Host stub: one scripted interface. The tests toggle its link state and its
+// global IPv6 so hasGlobalIPv6() sees the same shape it inspects on the device.
+#include "lwip/ip6_addr.h"
+
+#define NETIF_FLAG_UP 0x01U
+
+struct netif {
+  netif* next;
+  uint8_t flags;
+  ip_addr_t ip6_addr[LWIP_IPV6_NUM_ADDRESSES];
+  uint8_t ip6_addr_state[LWIP_IPV6_NUM_ADDRESSES];
+};
+
+inline netif* fakeNetif() {
+  static netif instance{};
+  return &instance;
+}
+
+inline void fakeNetifReset() { *fakeNetif() = netif{}; }
+
+// Brings the interface up with a valid 2001:db8::1 global unicast address.
+inline void fakeNetifSetGlobalV6(bool enable) {
+  netif* n = fakeNetif();
+  n->flags = enable ? NETIF_FLAG_UP : 0;
+  n->ip6_addr_state[0] = enable ? IP6_ADDR_VALID : 0;
+  if (enable) {
+    n->ip6_addr[0].type = IPADDR_TYPE_V6;
+    reinterpret_cast<uint8_t*>(&n->ip6_addr[0].u_addr.ip6)[0] = 0x20;
+  }
+}
+
+#define netif_list (fakeNetif())
+#define netif_is_up(netif) (((netif)->flags & NETIF_FLAG_UP) != 0)
+#define netif_ip6_addr(netif, i) (&((netif)->ip6_addr[i].u_addr.ip6))
+#define netif_ip6_addr_state(netif, i) ((netif)->ip6_addr_state[i])
