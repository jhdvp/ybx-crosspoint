diff --git a/libs/network/SecureNet/test/host/test_deadline_dns.cpp b/libs/network/SecureNet/test/host/test_deadline_dns.cpp
new file mode 100644
--- /dev/null
+++ b/libs/network/SecureNet/test/host/test_deadline_dns.cpp
@@ -0,0 +1,259 @@
+// Host test for DeadlineDns: deadline arithmetic, literal parsing, dual-stack
+// fallback, and the slot protocol that outlives a cancelled lookup (late
+// lwIP completion, including completions arriving on another thread).
+#include <Arduino.h>
+#include <DeadlineDns.h>
+
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+#include "lwip/dns.h"
+#include "lwip/netif.h"
+
+using freeink::deadlineAfter;
+using freeink::DeadlineDns;
+using freeink::remainingUntil;
+
+namespace {
+uint32_t makeIp(uint8_t a, uint8_t b, uint8_t c, uint8_t d) {
+  const uint8_t bytes[4] = {a, b, c, d};
+  uint32_t ip = 0;
+  memcpy(&ip, bytes, sizeof(ip));
+  return ip;
+}
+
+const uint8_t kV6Answer[16] = {0x20, 0x01, 0x0d, 0xb8, 0x00, 0x00, 0x00, 0x00,
+                               0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x42};
+const uint8_t kV6Literal[16] = {0x20, 0x01, 0x0d, 0xb8, 0x00, 0x00, 0x00, 0x00,
+                                0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01};
+
+void assertIp(const IPAddress& ip, uint8_t a, uint8_t b, uint8_t c, uint8_t d) {
+  assert(!ip.isV6());
+  assert(ip[0] == a && ip[1] == b && ip[2] == c && ip[3] == d);
+}
+
+void assertV6(const IPAddress& ip, const uint8_t (&bytes)[16]) {
+  assert(ip.isV6());
+  assert(memcmp(ip.bytes(), bytes, sizeof(bytes)) == 0);
+}
+
+void resetClock() {
+  fakeNow() = 0;
+  FakeDns::reset();
+  fakeNetifReset();
+}
+
+uint32_t now32() { return static_cast<uint32_t>(fakeNow()); }
+}  // namespace
+
+int main() {
+  // Deadline arithmetic is correct across the millis() wraparound.
+  {
+    const uint32_t start = 0xFFFFFFF0u;
+    const uint32_t deadline = deadlineAfter(start, 0x20);
+    assert(remainingUntil(start, deadline) == 0x20);
+    assert(remainingUntil(0x00000000u, deadline) == 0x10);
+    assert(remainingUntil(0x00000020u, deadline) == 0);
+    assert(remainingUntil(0x00000021u, deadline) == 0);
+    assert(remainingUntil(start, start) == 0);
+    assert(remainingUntil(start + 1, start) == 0);
+  }
+
+  // Literal addresses resolve without touching the resolver, in in_addr order.
+  {
+    resetClock();
+    uint32_t ip = 0;
+    assert(DeadlineDns::parseIpv4("192.168.1.20", ip));
+    uint8_t bytes[4];
+    memcpy(bytes, &ip, sizeof(bytes));
+    assert(bytes[0] == 192 && bytes[1] == 168 && bytes[2] == 1 && bytes[3] == 20);
+    assert(!DeadlineDns::parseIpv4("256.0.0.1", ip));
+    assert(!DeadlineDns::parseIpv4("1.2.3", ip));
+    assert(!DeadlineDns::parseIpv4("1.2.3.4.5", ip));
+    assert(!DeadlineDns::parseIpv4("a.b.c.d", ip));
+    assert(!DeadlineDns::parseIpv4(" 1.2.3.4", ip));
+    assert(!DeadlineDns::parseIpv4("01.2.3.4", ip));  // inet_aton would read octal
+    assert(!DeadlineDns::parseIpv4("", ip));
+    assert(!DeadlineDns::parseIpv4(nullptr, ip));
+
+    IPAddress address;
+    assert(DeadlineDns::resolve("10.0.0.7", deadlineAfter(0, 100), address, nullptr) == DeadlineDns::Status::Ok);
+    assertIp(address, 10, 0, 0, 7);
+    assert(DeadlineDns::resolve("2001:db8::1", deadlineAfter(0, 100), address, nullptr) == DeadlineDns::Status::Ok);
+    assertV6(address, kV6Literal);
+    assert(FakeDns::started == 0);
+    assert(DeadlineDns::resolve(nullptr, deadlineAfter(0, 100), address, nullptr) == DeadlineDns::Status::Failed);
+    assert(DeadlineDns::resolve("", deadlineAfter(0, 100), address, nullptr) == DeadlineDns::Status::Failed);
+  }
+
+  // A resolver cache hit completes immediately.
+  {
+    resetClock();
+    FakeDns::immediate[LWIP_DNS_ADDRTYPE_IPV4] = ERR_OK;
+    FakeDns::immediateIpv4 = makeIp(10, 0, 0, 7);
+    IPAddress address;
+    assert(DeadlineDns::resolve("cached.test", deadlineAfter(0, 100), address, nullptr) == DeadlineDns::Status::Ok);
+    assertIp(address, 10, 0, 0, 7);
+    assert(FakeDns::started == 1);
+  }
+
+  // NXDOMAIN surfaces as a fast failure, not as a timeout, and without a
+  // global IPv6 on any interface no AAAA query follows it.
+  {
+    resetClock();
+    FakeDns::failOnStart[LWIP_DNS_ADDRTYPE_IPV4] = true;
+    IPAddress address;
+    assert(DeadlineDns::resolve("nx.test", deadlineAfter(0, 100), address, nullptr) == DeadlineDns::Status::Failed);
+    assert(FakeDns::started == 1);
+    assert(fakeNow() == 0);
+  }
+
+  // With a global IPv6 the failed A query is retried as AAAA under the same
+  // deadline: an IPv6-only host keeps resolving.
+  {
+    resetClock();
+    fakeNetifSetGlobalV6(true);
+    FakeDns::failOnStart[LWIP_DNS_ADDRTYPE_IPV4] = true;
+    FakeDns::immediate[LWIP_DNS_ADDRTYPE_IPV6] = ERR_OK;
+    memcpy(FakeDns::immediateV6Bytes, kV6Answer, sizeof(kV6Answer));
+    IPAddress address;
+    assert(DeadlineDns::resolve("v6only.test", deadlineAfter(0, 100), address, nullptr) == DeadlineDns::Status::Ok);
+    assertV6(address, kV6Answer);
+    assert(FakeDns::started == 2);  // one A query, then one AAAA query
+    assert(fakeNow() == 0);
+
+    // Both families empty stays a failure.
+    resetClock();
+    fakeNetifSetGlobalV6(true);
+    FakeDns::failOnStart[LWIP_DNS_ADDRTYPE_IPV4] = true;
+    FakeDns::failOnStart[LWIP_DNS_ADDRTYPE_IPV6] = true;
+    assert(DeadlineDns::resolve("nx6.test", deadlineAfter(0, 100), address, nullptr) == DeadlineDns::Status::Failed);
+    assert(FakeDns::started == 2);
+
+    // A succeeds: IPv4 wins and no AAAA query is issued.
+    resetClock();
+    fakeNetifSetGlobalV6(true);
+    FakeDns::immediate[LWIP_DNS_ADDRTYPE_IPV4] = ERR_OK;
+    FakeDns::immediateIpv4 = makeIp(192, 0, 2, 1);
+    assert(DeadlineDns::resolve("dual.test", deadlineAfter(0, 100), address, nullptr) == DeadlineDns::Status::Ok);
+    assertIp(address, 192, 0, 2, 1);
+    assert(FakeDns::started == 1);
+
+    // The retry is for an empty answer only: a timed-out A query is not
+    // re-asked as AAAA.
+    resetClock();
+    fakeNetifSetGlobalV6(true);
+    FakeDns::immediate[LWIP_DNS_ADDRTYPE_IPV6] = ERR_OK;
+    memcpy(FakeDns::immediateV6Bytes, kV6Answer, sizeof(kV6Answer));
+    assert(DeadlineDns::resolve("slow.test", deadlineAfter(0, 5), address, nullptr) == DeadlineDns::Status::Timeout);
+    assert(FakeDns::started == 1);
+    fakeDnsFail(0);
+  }
+
+  // A blackholed resolver stops at the caller's deadline, and its late answer
+  // is safe to deliver after the waiter has left.
+  {
+    resetClock();
+    IPAddress address;
+    assert(DeadlineDns::resolve("blackhole.test", deadlineAfter(0, 5), address, nullptr) ==
+           DeadlineDns::Status::Timeout);
+    assert(fakeNow() == 5);
+    assert(FakeDns::pendingCount == 1);
+    fakeDnsComplete(0, makeIp(192, 0, 2, 1));
+  }
+
+  // Abort wins over a pending lookup without waiting for the deadline; the
+  // late answer is still delivered safely.
+  {
+    resetClock();
+    IPAddress address;
+    int checks = 0;
+    const DeadlineDns::AbortFn abort = [&checks] { return ++checks > 2; };
+    assert(DeadlineDns::resolve("abort.test", deadlineAfter(0, 1000), address, abort) == DeadlineDns::Status::Aborted);
+    assert(fakeNow() < 1000);
+    assert(FakeDns::pendingCount == 1);
+    fakeDnsFail(0);
+  }
+
+  // Timeouts consume the fixed slot pool; an exhausted pool waits for a slot
+  // to recycle (up to the deadline) instead of failing every later lookup
+  // instantly, and only the late completions recycle the abandoned slots.
+  {
+    resetClock();
+    IPAddress address;
+    for (int i = 0; i < 4; ++i) {
+      assert(DeadlineDns::resolve("hole.test", deadlineAfter(now32(), 2), address, nullptr) ==
+             DeadlineDns::Status::Timeout);
+    }
+    assert(FakeDns::started == 4);
+    const unsigned long before = fakeNow();
+    assert(DeadlineDns::resolve("fifth.test", deadlineAfter(now32(), 1000), address, nullptr) ==
+           DeadlineDns::Status::Busy);
+    assert(FakeDns::started == 4);       // no slot, so no query was issued
+    assert(fakeNow() == before + 1000);  // the wait used the whole deadline, not zero
+    for (int i = 0; i < 4; ++i) fakeDnsComplete(i, makeIp(192, 0, 2, 3));
+    FakeDns::immediate[LWIP_DNS_ADDRTYPE_IPV4] = ERR_OK;
+    FakeDns::immediateIpv4 = makeIp(192, 0, 2, 4);
+    assert(DeadlineDns::resolve("after.test", deadlineAfter(now32(), 100), address, nullptr) ==
+           DeadlineDns::Status::Ok);
+    assert(FakeDns::started == 5);
+  }
+
+  // A live timeout that crosses the millis() wraparound.
+  {
+    resetClock();
+    fakeNow() = 0xFFFFFFF0u;
+    IPAddress address;
+    const uint32_t deadline = deadlineAfter(now32(), 0x20);
+    assert(DeadlineDns::resolve("wrap.test", deadline, address, nullptr) == DeadlineDns::Status::Timeout);
+    assert(now32() == 0x10);
+    fakeDnsComplete(0, makeIp(1, 2, 3, 4));
+  }
+
+  // The cross-thread contract: a second thread plays the lwIP tcpip thread
+  // and answers queries while the waiter on the first thread abandons them.
+  // The publish/abandon CAS protocol must recycle every slot; afterwards a
+  // fresh lookup still works.
+  {
+    resetClock();
+    std::atomic<bool> stopDrain{false};
+    std::thread completer([&stopDrain] {
+      while (!stopDrain.load()) {
+        std::this_thread::sleep_for(std::chrono::microseconds(20));
+        std::lock_guard<std::mutex> guard(FakeDns::lock);
+        for (int i = 0; i < FakeDns::pendingCount; ++i) {
+          if (FakeDns::pending[i].found) fakeDnsCompleteLocked(i, makeIp(192, 0, 2, 7));
+        }
+      }
+    });
+    for (int i = 0; i < 300; ++i) {
+      IPAddress address;
+      int checks = 0;
+      const DeadlineDns::AbortFn abort = [&checks] { return ++checks > 2; };
+      const DeadlineDns::Status st = DeadlineDns::resolve("race.test", deadlineAfter(now32(), 1000000), address, abort);
+      assert(st == DeadlineDns::Status::Ok || st == DeadlineDns::Status::Failed || st == DeadlineDns::Status::Aborted);
+    }
+    stopDrain.store(true);
+    completer.join();
+    {
+      std::lock_guard<std::mutex> guard(FakeDns::lock);
+      for (int i = 0; i < FakeDns::pendingCount; ++i) {
+        if (FakeDns::pending[i].found) fakeDnsCompleteLocked(i, makeIp(192, 0, 2, 7));
+      }
+    }
+    FakeDns::immediate[LWIP_DNS_ADDRTYPE_IPV4] = ERR_OK;
+    FakeDns::immediateIpv4 = makeIp(192, 0, 2, 8);
+    IPAddress address;
+    assert(DeadlineDns::resolve("after.race.test", deadlineAfter(now32(), 10), address, nullptr) ==
+           DeadlineDns::Status::Ok);
+    assertIp(address, 192, 0, 2, 8);
+  }
+
+  puts("test_deadline_dns: ok");
+  return 0;
+}
diff --git a/libs/network/SecureNet/test/host/test_resumable_fetch.cpp b/libs/network/SecureNet/test/host/test_resumable_fetch.cpp
