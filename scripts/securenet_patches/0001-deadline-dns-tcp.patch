diff --git a/libs/network/SecureNet/test/host/stubs/lwip/ip_addr.h b/libs/network/SecureNet/test/host/stubs/lwip/ip_addr.h
new file mode 100644
--- /dev/null
+++ b/libs/network/SecureNet/test/host/stubs/lwip/ip_addr.h
@@ -0,0 +1,33 @@
+#pragma once
+// Host stub: the dual-stack subset of lwIP's address types that DeadlineDns
+// and the scripted resolver touch, with the real ip_addr_t shape (address
+// union plus a type tag).
+#include <cstdint>
+#include <cstring>
+
+#define LWIP_IPV6 1
+
+typedef struct ip4_addr {
+  uint32_t addr;
+} ip4_addr_t;
+
+typedef struct ip6_addr {
+  uint32_t addr[4];
+} ip6_addr_t;
+
+typedef struct ip_addr {
+  union {
+    ip6_addr_t ip6;
+    ip4_addr_t ip4;
+  } u_addr;
+  uint8_t type;
+} ip_addr_t;
+
+#define IPADDR_TYPE_V4 0U
+#define IPADDR_TYPE_V6 1U
+
+#define IP_IS_V4(ipaddr) (((ipaddr) == nullptr) || ((ipaddr)->type == IPADDR_TYPE_V4))
+#define IP_IS_V6(ipaddr) (((ipaddr) != nullptr) && ((ipaddr)->type == IPADDR_TYPE_V6))
+#define ip_2_ip4(ipaddr) (&((ipaddr)->u_addr.ip4))
+#define ip_2_ip6(ipaddr) (&((ipaddr)->u_addr.ip6))
+#define ip4_addr_get_u32(ip4addr) ((ip4addr)->addr)
diff --git a/libs/network/SecureNet/test/host/stubs/lwip/netif.h b/libs/network/SecureNet/test/host/stubs/lwip/netif.h
