   return err == WOLFSSL_ERROR_WANT_READ || err == WOLFSSL_ERROR_WANT_WRITE;
 }
+
+// A verification failure must reach the caller as such, not as a generic
+// network error: the user-facing fix (trust, clock, host name) differs.
+SecureClient::ConnectFailure classifyHandshakeError(const int err) {
+  switch (err) {
+    case DOMAIN_NAME_MISMATCH:
+      return SecureClient::ConnectFailure::Hostname;
+    case ASN_BEFORE_DATE_E:
+    case ASN_AFTER_DATE_E:
+      return SecureClient::ConnectFailure::Clock;
+    case ASN_NO_SIGNER_E:
+    case ASN_SIG_CONFIRM_E:
+    case ASN_SELF_SIGNED_E:
+    case ASN_PATHLEN_INV_E:
+    case ASN_NO_PEM_HEADER:
+    case VERIFY_CERT_ERROR:
+    case VERIFY_FINISHED_ERROR:
+    case NO_PEER_CERT:
+      return SecureClient::ConnectFailure::Certificate;
+    case MEMORY_E:
+    case MEMORY_ERROR:
+    case BUFFER_E:
+      return SecureClient::ConnectFailure::Memory;
+    default:
+      return SecureClient::ConnectFailure::Transport;
+  }
+}
